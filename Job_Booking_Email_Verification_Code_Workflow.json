{
  "name": "Job Booking - Automated Email Verification Codes",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "job-booking-auth-code",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-webhook-trigger",
      "name": "Job Booking Auth Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ],
      "webhookId": "7a35c102-16e8-46da-bc42-f542fae930f1"
    },
    {
      "parameters": {
        "jsCode": "// Prepare email subject and mobile-friendly HTML template\nconst input = $input.first().json;\n\nconst email = String(input.email || '').trim();\nconst name = String(input.name || 'Artisan / Worker').trim();\nconst code = String(input.code || '000000').trim();\nconst expires = input.expires_in_minutes || 15;\n\nif (!email) {\n  throw new Error('Email address is missing in the webhook payload.');\n}\n\nconst subject = `Your Job Booking Sign-in Code: ${code}`;\n\nconst textBody = `Hello ${name},\\n\\nYour 6-digit login verification code for Job Booking is:\\n\\n${code}\\n\\nThis code will expire in ${expires} minutes.\\n\\nIf you did not request this, please ignore this email.\\n\\nJob Booking for Nigerian Artisans 🇳🇬`;\n\nconst htmlBody = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n</head>\n<body style=\"margin: 0; padding: 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #e8f5f3;\">\n  <div style=\"max-width: 480px; margin: 0 auto; background-color: #ffffff; border-radius: 20px; padding: 30px 24px; box-shadow: 0 10px 25px rgba(0,0,0,0.06); border: 1.5px solid #ccfbf1;\">\n    \n    <!-- Header -->\n    <div style=\"text-align: center; margin-bottom: 24px;\">\n      <div style=\"display: inline-block; width: 52px; height: 52px; line-height: 52px; background: linear-gradient(135deg, #0d9488, #0284c7); border-radius: 14px; font-size: 26px; color: #ffffff;\">\n        🛠️\n      </div>\n      <h2 style=\"margin: 10px 0 2px 0; font-size: 22px; color: #0f172a; font-weight: 800;\">Job Booking</h2>\n      <p style=\"margin: 0; color: #0d9488; font-size: 13px; font-weight: 700;\">For Nigerian Trades & Artisans 🇳🇬</p>\n    </div>\n\n    <!-- Greeting -->\n    <p style=\"color: #1e293b; font-size: 15px; margin-bottom: 12px; line-height: 1.5;\">\n      Hello <strong>${name}</strong>,\n    </p>\n    <p style=\"color: #475569; font-size: 14px; line-height: 1.5; margin-bottom: 20px;\">\n      Use the verification code below to securely sign in to your workshop account:\n    </p>\n\n    <!-- Code Box -->\n    <div style=\"background: linear-gradient(135deg, #0d9488, #0284c7); border-radius: 14px; padding: 18px; text-align: center; margin-bottom: 22px; box-shadow: 0 8px 18px rgba(13, 148, 136, 0.25);\">\n      <span style=\"font-size: 36px; font-weight: 900; letter-spacing: 8px; color: #ffffff; font-family: monospace;\">\n        ${code}\n      </span>\n    </div>\n\n    <!-- Expiration notice -->\n    <div style=\"background-color: #fff7ed; border: 1px solid #fed7aa; border-radius: 10px; padding: 10px 14px; margin-bottom: 24px; display: flex; align-items: center;\">\n      <span style=\"font-size: 18px; margin-right: 8px;\">⏱️</span>\n      <span style=\"color: #9a3412; font-size: 13px; font-weight: 600;\">\n        This code is valid for <strong>${expires} minutes</strong>. Do not share it with anyone.\n      </span>\n    </div>\n\n    <!-- Footer -->\n    <div style=\"border-top: 1px dashed #e2e8f0; padding-top: 16px; text-align: center;\">\n      <p style=\"color: #94a3b8; font-size: 12px; margin: 0;\">\n        If you did not request this login code, you can safely ignore this email.\n      </p>\n    </div>\n\n  </div>\n</body>\n</html>\n`;\n\nreturn [{\n  json: {\n    email,\n    name,\n    code,\n    subject,\n    text_body: textBody,\n    html_body: htmlBody\n  }\n}];"
      },
      "id": "node-template-code",
      "name": "Format Verification Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.html_body }}",
        "options": {}
      },
      "id": "node-send-email",
      "name": "Send Gmail Verification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        740,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "ReCn1OmM59jDx5F4",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "options": {},
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Verification code sent to \" + $json.email,\n  \"code_sent_at\": new Date().toISOString()\n}"
      },
      "id": "node-respond-webhook",
      "name": "Respond to Job Booking",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        980,
        300
      ]
    }
  ],
  "connections": {
    "Job Booking Auth Webhook": {
      "main": [
        [
          {
            "node": "Format Verification Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Verification Email": {
      "main": [
        [
          {
            "node": "Send Gmail Verification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Gmail Verification": {
      "main": [
        [
          {
            "node": "Respond to Job Booking",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
